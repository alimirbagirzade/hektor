# Hektor environment template
# Copy to .env and adjust. NEVER commit .env.

# ===========================================================================
# === LLM — YALNIZ YEREL OLLAMA. PAY-PER-TOKEN API KULLANILMAZ. =============
# ===========================================================================
# Bu proje LOKAL-ÖNCELİKLİDİR: çalışma-zamanı LLM hattı tamamen YERELDİR.
# Bulut sağlayıcı (OpenAI / Anthropic / Google) istemci kodu ve ayarları
# BİLİNÇLİ OLARAK YOKTUR — kalıcı proje kısıtı. AI yardımı aylık ABONELİKLİ
# araçlarla (Claude Code / Codex CLI) yapılır, faturalı API anahtarıyla DEĞİL.

HEKTOR_OLLAMA_HOST=http://127.0.0.1:11434
HEKTOR_EMBED_MODEL=nomic-embed-text
# Modeli sorgu sonrası ne kadar yüklü tutsun. Aynı anda LoRA EĞİTİMİ varsa "0" (hemen
# boşalt → ~7GB çakışma/OOM önlenir). Büyük makinede "5m" ardışık sorguyu hızlandırır.
HEKTOR_OLLAMA_KEEP_ALIVE=30s

# === RAM PROFİLİ: BİR tane HEKTOR_LLM_MODEL seç ==========================
#  8 GB  (varsayılan) -> qwen3:4b   (~2.5GB, thinking+no_think destekli)
#  16 GB              -> qwen3:8b
#  32 GB+             -> qwen3:14b
HEKTOR_LLM_MODEL=qwen3:4b
# HEKTOR_LLM_MODEL=qwen3:8b
# HEKTOR_LLM_MODEL=qwen3:14b
# ===========================================================================

# --- LoRA eğitimi için MLX model (yalnızca macOS Apple Silicon) ---
HEKTOR_MLX_BASE_MODEL=models/mlx/Qwen3-4B-4bit

# --- Embedding / çevrimdışı davranış ---
HEKTOR_ALLOW_FAKE_EMBEDDINGS=true

# --- RAG / chunking ---
HEKTOR_RAG_TOP_K=6
HEKTOR_CHUNK_SIZE=1200
HEKTOR_CHUNK_OVERLAP=200

# --- Kök dizin ve depolama ---
# HEKTOR_ROOT_PATH: TÜM veri/rapor/durum yollarının tabanı (data/, reports/,
# storage/, models/, logs/). Boş = depo kökü. Testler bunu tmp'ye yönlendirir.
# HEKTOR_ROOT_PATH=
# HEKTOR_SQLITE_PATH=storage/sqlite/hektor_trader_ai.db
# HEKTOR_CHROMA_PATH=vector_db/chroma

# --- Trading varsayılanları ---
HEKTOR_DEFAULT_MARKET=XAUUSD
HEKTOR_DEFAULT_TIMEFRAME=15m

# --- Auto-LoRA hattı ---
# Gözetimsiz eğitim yetkisinin TEK anahtarı. false = her eğitim tek-kullanımlık
# insan onayı ister (CLAUDE.md Kural 8).
HEKTOR_UNATTENDED_TRAINING_ENABLED=false
HEKTOR_AUTO_LORA_MIN_CARDS=20
HEKTOR_AUTO_LORA_CHECK_INTERVAL_MIN=60
HEKTOR_AUTO_LORA_EVAL_THRESHOLD=0.5

# --- Arka plan döngüleri (web lifespan) ---
# false → auto-lora / rag-loop / self-heal / unattended supervisor HİÇ başlamaz.
# Testler bunu kapatır (aksi halde gerçek bir abonelik motoru doğurulabilirdi).
HEKTOR_BACKGROUND_LOOPS_ENABLED=true

# Web'den PDF yüklenince ingest ardından OTOMATİK bilgi kartı + anlama skoru üret.
# Varsayılan false: her yükleme ~1-2 dk yerel LLM işi (GPU'suz ~40 sn/çağrı) ve
# ingest/synth-qa ile aynı Ollama'yı paylaşır. Boş kart kaydedilmez (yalnız uyarı).
HEKTOR_AUTO_CARD_ON_UPLOAD=false

# Bilgi kartı üreticisine verilen makale metni tavanı (karakter). Prompt işleme yerel
# CPU'da ~30 token/sn: 6000 ≈ 55 sn, 3000 ≈ yarısı. Ölçüldü: retry'larla kart başına ~6 dk.
# Hız gerekince 3000'e in (kart biraz daha yüzeysel olabilir).
HEKTOR_CARD_MAX_CHARS=6000

# Kart üreticisinin tek LLM çağrısı zaman aşımı (sn). Ollama istekleri sıraya koyar; başka bir
# iş (synth-qa) koşarken kart isteği önce kuyrukta bekler. 180 sn paylaşımlı kullanımda isteği
# üretim sürerken düşürüp emeği çöpe atar (ölçüldü). Paylaşımlı Ollama'da 420+.
HEKTOR_CARD_LLM_TIMEOUT_S=180

# --- RLM (yerel, tek motor) ---
# Üretimde local-exec / shell / network / fs-write YASAK. Dış "recursive reasoning"
# motor adapter'ı yoktur (API anahtarı + docker isterdi).
HEKTOR_RLM_PRODUCTION_MODE=true

# --- Loglama ---
HEKTOR_LOG_LEVEL=INFO

# --- Sentez aynalama (opsiyonel) ---
# Üretilen her sentez makalesi (reports/synthesis/sentez_*.md) ayrıca bu dizine
# kopyalanır (best-effort). Boş = KAPALI. Örnek:
# HEKTOR_SYNTHESIS_MIRROR_DIR=C:\Users\KULLANICI\Desktop\Sentez

# --- Web arayüzü (hektor-web) ---
HEKTOR_WEB_HOST=127.0.0.1          # yalnız localhost; ağa açmak için 0.0.0.0 + token
HEKTOR_WEB_PORT=8765
# Token YOKSA kimlik doğrulama KAPALIDIR. Ağa açmadan önce güçlü değer ata:
#   HEKTOR_API_TOKEN=$(openssl rand -hex 32)
HEKTOR_API_TOKEN=
HEKTOR_RATE_LIMIT_PER_MIN=120
# Yükleme uçlarına (PDF/CSV) ayrı, daha sıkı limit — ağ DoS / disk doldurma.
HEKTOR_UPLOAD_RATE_LIMIT_PER_MIN=60
# Upload boyut limiti (PDF + CSV). Not: dosya tamamen RAM'e okunur.
HEKTOR_MAX_UPLOAD_MB=500

# --- AĞA AÇARKEN (uzak/kiralık CPU) — lokal kullanımda boş/false bırak ---
# Host-header koruması (boş = kısıt yok). Ağa açarken alan adını/IP'yi ver:
HEKTOR_TRUSTED_HOSTS=
# TLS (reverse proxy/HTTPS) arkasındaysan true → Strict-Transport-Security başlığı:
HEKTOR_HSTS_ENABLED=false
# Adım-adım sertleştirme checklist: SECURITY.md
